HINT_NARROW = _banner_meta.get("hint_narrow", "/help|/quit")


def _render_hint(spec: str) -> str:
    rendered = []
    for p in [p.strip() for p in (spec or "").split("|") if p.strip()]:
        if p == "query":
            rendered.append(c(Colors.GREEN, p))
        elif p in ("/help", "help"):
            rendered.append(c(Colors.CYAN, p))
        elif p in ("/quit", "quit", "exit"):
            rendered.append(c(Colors.RED, p))
        else:
            rendered.append(c(Colors.GRAY, p))
    return f" {c(Colors.GRAY, '·')} ".join(rendered)


def make_banner(width: int = None) -> str:
    if width is None:
        width = get_terminal_width()
    if width >= 82:
        art, banner_width = BANNER_ART_FULL or BANNER_ART_MINI, 80
    elif width >= 45:
        art, banner_width = BANNER_ART_COMPACT or BANNER_ART_MINI, min(width - 2, 45)
    else:
        art, banner_width = BANNER_ART_MINI or ["AGENT8088"], min(width - 2, 33)

    lines = [f"{BANNER_COLORS[i % len(BANNER_COLORS)]}{art_line}{Colors.RESET}" for i, art_line in enumerate(art)]

    line_width = min(banner_width, width - 2)
    left = max(0, (line_width - len(VERSION_TEXT)) // 2)
    right = max(0, line_width - len(VERSION_TEXT) - left)
    version_line = (f"{Colors.GRAY}{'─' * left}{Colors.RESET}"
                    f"{c(Colors.CYAN, VERSION_TEXT, bold=True)}"
                    f"{Colors.GRAY}{'─' * right}{Colors.RESET}")
    lines += ["", version_line]

    if width >= len(AUTHOR_TEXT) + 4:
        pad = max(0, (line_width - len(AUTHOR_TEXT)) // 2)
        lines.append(f"{' ' * pad}{c(Colors.GRAY, AUTHOR_TEXT)}")

    hint = f"  {_render_hint(HINT_WIDE)}" if width >= 40 else f" {_render_hint(HINT_NARROW)}"
    lines += ["", hint, ""]
    return "\n".join(lines)


