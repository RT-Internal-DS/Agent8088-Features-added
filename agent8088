    "\033[38;5;208m",  # Orange
    "\033[38;5;214m",  # Light orange
    "\033[38;5;220m",  # Gold
    "\033[38;5;44m",   # Teal
    "\033[38;5;38m",   # Cyan
    "\033[38;5;32m",   # Blue-cyan
]


def load_banner_data(path: Path):
    default = {
        "full": [], "compact": [], "mini": ["AGENT8088"],
        "meta": {
            "version_text": " v2 ", "author_text": "",
            "hint_wide": "query|/help|/quit", "hint_narrow": "/help|/quit",
            "plaintext_title": "AGENT8088", "plaintext_author": "",
            "plaintext_hint": "query|/help|/quit",
        },
    }
    if not path.exists():
        return default

    out = {"full": [], "compact": [], "mini": [], "meta": dict(default["meta"])}
    current = None
    for raw in path.read_text().splitlines():
        line = raw.rstrip("\n")
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped[1:-1].strip().lower()
            current = section if section in ("full", "compact", "mini", "meta") else None
        elif current in ("full", "compact", "mini"):
            out[current].append(line)
        elif current == "meta" and "=" in line:
            k, v = line.split("=", 1)
            out["meta"][k.strip()] = v.strip()

    for key in ("full", "compact", "mini"):
        if not out[key]:
            out[key] = default[key]
    return out


