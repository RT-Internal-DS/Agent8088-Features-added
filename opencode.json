{
  "$schema": "https://opencode.ai/config.json",
  "model": "freellmapi/gpt-oss-120b",
  "small_model": "freellmapi/gpt-oss-120b",
  "provider": {
    "freellmapi": {
      "name": "FreeLLMAPI",
      "options": {
        "baseURL": "http://127.0.0.1:3001/v1",
        "apiKey": "YOUR_API_KEY_HERE",
        "timeout": 120000
      },
      "models": {
        "gpt-oss-120b": {
          "id": "openai/gpt-oss-120b",
          "name": "GPT-OSS 120B via FreeLLMAPI",
          "tool_call": true,
          "temperature": true
        }
      }
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail"
  ]
}